{
  "name": "pis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go tool mygo build",
    "build:web": "vite build --config frontend/vite.config.ts",
    "check": "sh scripts/check.sh",
    "check:web": "vp check --deny-warnings --continue-on-error",
    "dev": "go tool mygo dev",
    "dev:web": "vite --config frontend/vite.config.ts",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "format": "go fmt $(go list ./... | grep -v /node_modules/) && vp fmt",
    "generate": "go tool mygo generate",
    "prepare": "vp config --no-agent",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:bridge": "bun test internal/bridge/bridge.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@streamdown/cjk": "1.0.5",
    "@streamdown/code": "2.0.1",
    "@streamdown/math": "1.0.4",
    "@streamdown/mermaid": "1.0.4",
    "@tanstack/react-virtual": "3.14.28",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "katex": "0.19.1",
    "lucide-react": "1.78.0",
    "mygo-runtime": "0.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.8.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@rspress/core": "2.1.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "mygo-cli": "0.10.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plus": "1.8.0",
    "vitest": "5.1.1"
  }
}
